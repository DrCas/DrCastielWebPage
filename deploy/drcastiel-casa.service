[Unit]
Description=Private CasaOS HTTPS gateway over Tailscale
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service
StartLimitIntervalSec=0

[Service]
Type=simple
RuntimeDirectory=drcastiel-casa
StateDirectory=drcastiel-casa
ExecStartPre=/usr/sbin/nginx -t -c /etc/drcastiel/casa-nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/drcastiel/casa-nginx.conf -g "daemon off;"
ExecReload=/usr/sbin/nginx -s reload -c /etc/drcastiel/casa-nginx.conf
KillSignal=SIGQUIT
TimeoutStopSec=10
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/nginx /run/drcastiel-casa /var/lib/drcastiel-casa

[Install]
WantedBy=multi-user.target

