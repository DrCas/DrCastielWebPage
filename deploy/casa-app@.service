[Unit]
Description=Forward private CasaOS app port %i to CasServer
Requires=casa-app@%i.socket
After=casa-app@%i.socket

[Service]
Type=notify
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time=5min 100.117.231.66:%i
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
